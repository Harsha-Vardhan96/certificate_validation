# ==========================================
# CertiVerify Global - Root .gitignore
# ==========================================

# --- Frontend Dependencies & Builds ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/

# --- Environment & Credentials ---
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
!.env.example
!frontend/.env.example

# --- Java & Maven Build Artifacts ---
target/
**/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# --- Large Archive, Backup & Tool Artifacts ---
apache-maven-*/
**/apache-maven-*/
maven.zip
*.zip
spring-boot-metadata.xml
spring-cloud-metadata.xml
git_backup_*/
review backend/
**/.git_original*


# --- Logs & Temporary Files ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp

# --- Uploaded Documents & Runtime Media ---
uploads/
**/uploads/

# --- IDEs & Editors ---
.idea/
*.iws
*.iml
*.ipr
.vscode/*
!.vscode/extensions.json
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
.metadata/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating System Files ---
.DS_Store
Thumbs.db
